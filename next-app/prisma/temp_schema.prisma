generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model UserCalendarEvent {
  id          String   @id @default(uuid())
  userId      Int      @map("user_id")
  mediaType   String   @map("media_type")
  tmdbId      String   @map("tmdb_id")
  title       String
  releaseDate DateTime @map("release_date")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId, mediaType])
  @@index([userId, releaseDate])
  @@map("user_calendar_events")
}

model User {
  id               Int                 @id @default(autoincrement())
  name             String
  email            String              @unique
  emailVerified    DateTime?
  password         String?
  image            String?
  embyUserId       String?             @unique @map("emby_user_id")
  jellyseerrUserId String?             @map("jellyseerr_user_id")
  role             String              @default("user")
  roleId           String?             @map("role_id")
  hasSeenWelcome   Boolean             @default(false) @map("has_seen_welcome")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  accounts         Account[]
  auditLogs        AuditLog[]
  requests         MediaRequest[]
  notifications    Notification[]
  sessions         Session[]
  calendarEvents   UserCalendarEvent[]
  roleRef          Role?               @relation(fields: [roleId], references: [id])
  watchEvents      WatchEvent[]
  watchLater       WatchLater[]

  @@map("users")
}

model Notification {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  title      String
  message    String
  type       String
  mediaId    String?  @map("media_id")
  mediaType  String?  @map("media_type")
  posterPath String?  @map("poster_path")
  isRead     Boolean  @default(false) @map("is_read")
  link       String?
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model WatchLater {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  mediaId    String   @map("media_id")
  tmdbId     String?  @map("tmdb_id")
  mediaType  String   @map("media_type")
  title      String
  posterPath String?  @map("poster_path")
  isEmbyItem Boolean  @default(false) @map("is_emby_item")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId, mediaType])
  @@map("watch_later")
}

model Account {
  id                Int     @id @default(autoincrement())
  userId            Int     @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique @map("session_token")
  userId       Int      @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model MediaRequest {
  id              Int       @id @default(autoincrement())
  userId          Int?      @map("user_id")
  mediaType       String    @map("media_type")
  tmdbId          String    @map("tmdb_id")
  title           String
  description     String?
  status          Int       @default(1)
  externalId      String?   @map("external_id")
  metadata        String?
  notes           String?
  requestedAt     DateTime  @default(now()) @map("requested_at")
  processedAt     DateTime? @map("processed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  isOnEmby        Boolean   @default(false) @map("is_on_emby")
  embyItemId      String?   @map("emby_item_id")
  requesterName   String?   @map("requester_name")
  requesterEmail  String?   @map("requester_email")
  requesterAvatar String?   @map("requester_avatar")
  user            User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([mediaType, status])
  @@index([tmdbId])
  @@map("media_requests")
}

model WatchEvent {
  id              Int      @id @default(autoincrement())
  userId          Int?     @map("user_id")
  embyUserId      String   @map("emby_user_id")
  itemId          String   @map("item_id")
  itemType        String?  @map("item_type")
  itemName        String?  @map("item_name")
  seriesName      String?  @map("series_name")
  durationMinutes Int      @default(0) @map("duration_minutes")
  plays           Int      @default(1)
  playedAt        DateTime @map("played_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  client          String?
  device          String?
  episodeNumber   Int?     @map("episode_number")
  ipAddress       String?  @map("ip_address")
  playMethod      String?  @map("play_method")
  seasonName      String?  @map("season_name")
  sessionId       String?  @map("session_id")
  userName        String?  @map("user_name")
  user            User?    @relation(fields: [userId], references: [id])

  @@unique([embyUserId, itemId, playedAt])
  @@map("watch_events")
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String?
  type      String   @default("string")
  group     String   @default("general")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model MediaAvailabilityIndex {
  id               Int      @id @default(autoincrement())
  tmdbId           String   @unique @map("tmdb_id")
  mediaType        String   @map("media_type")
  isAvailable      Boolean  @default(false) @map("is_available")
  availabilityData String?  @map("availability_data")
  jellyseerrStatus Int?     @map("jellyseerr_status")
  lastCheckedAt    DateTime @default(now()) @map("last_checked_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([mediaType, isAvailable])
  @@map("media_availability_index")
}

model FileShare {
  id        String    @id @default(uuid())
  filePath  String    @map("file_path")
  token     String    @unique
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("file_shares")
}

model EmbyLiveSession {
  id                  String   @id @default(uuid())
  sessionId           String   @unique @map("session_id")
  source              String   @default("emby")
  userId              String   @map("user_id")
  userName            String   @map("user_name")
  client              String?
  device              String?
  deviceId            String?  @map("device_id")
  applicationVersion  String?  @map("app_version")
  itemId              String?  @map("item_id")
  itemName            String?  @map("item_name")
  itemType            String?  @map("item_type")
  runTimeTicks        BigInt?  @map("runtime_ticks")
  isPaused            Boolean  @default(false) @map("is_paused")
  lastActivity        DateTime @default(now()) @map("last_activity")
  startedAt           DateTime @default(now()) @map("started_at")
  playbackPosition    BigInt?  @map("playback_position")
  accumulatedDuration Int      @default(0) @map("accumulated_duration")

  @@map("emby_live_sessions")
}

model UserGroup {
  id        String            @id @default(uuid())
  name      String
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  members   UserGroupMember[]

  @@map("user_groups")
}

model UserGroupMember {
  id          Int       @id @default(autoincrement())
  userGroupId String    @map("user_group_id")
  userId      String    @map("user_id")
  username    String?
  userGroup   UserGroup @relation(fields: [userGroupId], references: [id], onDelete: Cascade)

  @@unique([userGroupId, userId])
  @@map("user_group_members")
}

model EmbyActivityLog {
  id            String    @id @default(uuid())
  source        String    @default("emby")
  embyUserId    String    @map("emby_user_id")
  userName      String    @map("user_name")
  itemId        String    @map("item_id")
  itemName      String    @map("item_name")
  itemType      String    @map("item_type")
  startTime     DateTime  @default(now()) @map("start_time")
  endTime       DateTime? @map("end_time")
  playDuration  Int       @default(0) @map("play_duration")
  totalDuration BigInt?   @map("total_duration")
  client        String?
  device        String?
  deviceId      String?   @map("device_id")
  ipAddress     String?   @map("ip_address")
  mediaInfo     String?   @map("media_info")

  @@index([embyUserId])
  @@index([startTime])
  @@map("emby_activity_logs")
}

model DockerGroup {
  id        String              @id @default(cuid())
  name      String
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")
  members   DockerGroupMember[]

  @@map("docker_groups")
}

model DockerGroupMember {
  id            String      @id @default(cuid())
  groupId       String      @map("group_id")
  containerName String      @map("container_name")
  group         DockerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, containerName])
  @@map("docker_group_members")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    Int      @map("user_id")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  details   String?
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  isSystem    Boolean      @default(false)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  permissions Permission[]
  users       User[]

  @@map("roles")
}

model Permission {
  id         String  @id @default(cuid())
  action     String
  subject    String
  conditions String?
  roleId     String  @map("role_id")
  role       Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@map("permissions")
}
