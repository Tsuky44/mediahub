generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AccountRequest {
  id        String   @id @default(cuid())
  email     String   @unique
  firstName String   @map("first_name")
  inviter   String?
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("account_requests")
}

model DailyTrackerStat {
  id              Int      @id @default(autoincrement())
  date            DateTime @map("date") // Date only (00:00:00)
  tracker         String
  totalUploaded   BigInt   @default(0) @map("total_uploaded")
  totalDownloaded BigInt   @default(0) @map("total_downloaded")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([date, tracker])
  @@index([date])
  @@map("daily_tracker_stats")
}

model TrackerStatsLog {
  id              Int      @id @default(autoincrement())
  tracker         String
  totalUploaded   BigInt   @map("total_uploaded")
  totalDownloaded BigInt   @map("total_downloaded")
  uploadedDiff    BigInt   @default(0) @map("uploaded_diff")
  downloadedDiff  BigInt   @default(0) @map("downloaded_diff")
  timestamp       DateTime @default(now())

  @@index([timestamp])
  @@index([tracker, timestamp])
  @@map("tracker_stats_logs")
}

model UserCalendarEvent {
  id        String   @id @default(uuid())
  userId    Int      @map("user_id")
  mediaType String   @map("media_type")
  tmdbId    String   @map("tmdb_id")
  title     String
  releaseDate DateTime @map("release_date")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId, mediaType])
  @@index([userId, releaseDate])
  @@map("user_calendar_events")
}

model User {
  id               Int            @id @default(autoincrement())
  name             String
  email            String         @unique
  emailVerified    DateTime?
  password         String?
  image            String?
  embyUserId       String?        @unique @map("emby_user_id")
  jellyfinUserId   String?        @unique @map("jellyfin_user_id")
  plexUserId       String?        @unique @map("plex_user_id")
  jellyseerrUserId String?        @map("jellyseerr_user_id")
  role             String         @default("user") // Denormalized role name
  roleId           String?        @map("role_id")
  roleRef          Role?          @relation(fields: [roleId], references: [id])
  hasSeenWelcome   Boolean        @default(false) @map("has_seen_welcome")
  lastSeenSystemMessageVersion String? @map("last_seen_system_message_version")
  telegramChatId   String?        @map("telegram_chat_id")
  discordUserId    String?        @map("discord_user_id")
  discordWebhook   String?        @map("discord_webhook")
  customWebhook    String?        @map("custom_webhook")
  whatsappNumber   String?        @map("whatsapp_number")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  accounts         Account[]
  auditLogs        AuditLog[]
  requests         MediaRequest[]
  notifications    Notification[]
  sessions         Session[]
  watchEvents      WatchEvent[]
  watchLater       WatchLater[]
  calendarEvents   UserCalendarEvent[]
  groupMemberships UserGroupMember[]
  subscriptions    MediaSubscription[]

  @@map("users")
}

model Notification {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  title      String
  message    String
  type       String
  mediaId    String?  @map("media_id")
  mediaType  String?  @map("media_type")
  posterPath String?  @map("poster_path")
  isRead     Boolean  @default(false) @map("is_read")
  link       String?
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model WatchLater {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  mediaId    String   @map("media_id")
  tmdbId     String?  @map("tmdb_id")
  mediaType  String   @map("media_type")
  title      String
  posterPath String?  @map("poster_path")
  isEmbyItem Boolean  @default(false) @map("is_emby_item")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId, mediaType])
  @@map("watch_later")
}

model Account {
  id                Int     @id @default(autoincrement())
  userId            Int     @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique @map("session_token")
  userId       Int      @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model MediaRequest {
  id              Int       @id @default(autoincrement())
  userId          Int?      @map("user_id")
  mediaType       String    @map("media_type")
  tmdbId          String    @map("tmdb_id")
  title           String
  description     String?
  status          Int       @default(1)
  externalId      String?   @map("external_id")
  metadata        String?
  notes           String?
  requestedAt     DateTime  @default(now()) @map("requested_at")
  processedAt     DateTime? @map("processed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  isOnEmby        Boolean   @default(false) @map("is_on_emby")
  embyItemId      String?   @map("emby_item_id")
  requesterName   String?   @map("requester_name")
  requesterEmail  String?   @map("requester_email")
  requesterAvatar String?   @map("requester_avatar")
  user            User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([mediaType, status])
  @@index([tmdbId])
  @@map("media_requests")
}

model WatchEvent {
  id              Int      @id @default(autoincrement())
  userId          Int?     @map("user_id")
  embyUserId      String   @map("emby_user_id")
  itemId          String   @map("item_id")
  itemType        String?  @map("item_type")
  itemName        String?  @map("item_name")
  seriesName      String?  @map("series_name")
  durationMinutes Int      @default(0) @map("duration_minutes")
  plays           Int      @default(1)
  playedAt        DateTime @map("played_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  client          String?
  device          String?
  episodeNumber   Int?     @map("episode_number")
  ipAddress       String?  @map("ip_address")
  playMethod      String?  @map("play_method")
  seasonName      String?  @map("season_name")
  seasonNumber    Int?     @map("season_number")
  sessionId       String?  @map("session_id")
  userName        String?  @map("user_name")
  tmdbId          String?  @map("tmdb_id")
  user            User?    @relation(fields: [userId], references: [id])

  @@unique([embyUserId, itemId, playedAt])
  @@map("watch_events")
}

model Setting {
  id         Int      @id @default(autoincrement())
  key        String   @unique
  value      String?
  category   String   @default("general")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String
  entity    String?
  entityId  String?  @map("entity_id")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  details   String?
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  permissions Permission[]
  isSystem    Boolean      @default(false) @map("is_system")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  users       User[]
  groups      UserGroup[]

  @@map("roles")
}

model Permission {
  id         String  @id @default(uuid())
  action     String
  subject    String
  conditions String? // JSON string
  roleId     String  @map("role_id")
  role       Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@map("permissions")
}

model MediaSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  tmdbId    String   @map("tmdb_id")
  mediaType String   @map("media_type") // 'movie' or 'tv'
  title     String
  posterPath String? @map("poster_path")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId, mediaType])
  @@map("media_subscriptions")
}

model UserGroup {
  id          String            @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  members     UserGroupMember[]
  roleId      String?           @map("role_id")
  role        Role?             @relation(fields: [roleId], references: [id])

  @@map("user_groups")
}

model UserGroupMember {
  id          String    @id @default(uuid())
  userId      Int       @map("user_id")
  userGroupId String    @map("user_group_id")
  joinedAt    DateTime  @default(now()) @map("joined_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  group       UserGroup @relation(fields: [userGroupId], references: [id], onDelete: Cascade)

  @@unique([userId, userGroupId])
  @@map("user_group_members")
}

model FileShare {
  id        String    @id @default(uuid())
  filePath  String    @map("file_path")
  token     String    @unique
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("file_shares")
}
