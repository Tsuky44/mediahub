# Port de l'application
APP_PORT=3008

# URL publique de l'application (ex: http://mon-serveur.com:3008)
NEXTAUTH_URL=http://localhost:3008

# Secret pour l'authentification (Générez-en un nouveau pour la prod !)
# Vous pouvez utiliser : openssl rand -base64 32
NEXTAUTH_SECRET=change_me_in_production
